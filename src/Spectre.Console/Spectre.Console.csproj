<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants)TRACE;WCWIDTH_VISIBILITY_INTERNAL;WCWIDTH</DefineConstants>
  </PropertyGroup>
 

  <ItemGroup>
    <!-- Jumbee.Console consumes Spectre only through public API (the fork exposes what it needs), so it is
         intentionally NOT a friend: granting it internals surfaces internal helpers (Cell, ListExtensions,
         EnumerableExtensions) that collide with ConsoleGUI/Interop types. RazorConsole.Core.Syntax needs the
         internal zero-copy Segment slice ctor for its direct-segment highlighter. -->
    <InternalsVisibleTo Include="RazorConsole.Core.Syntax"/>
    <InternalsVisibleTo Include="Spectre.Console.Tests"/>
  </ItemGroup>

  <ItemGroup Label="Standard Figlet font">
    <EmbeddedResource Include="Widgets\Figlet\Fonts\Standard.flf" />
    <None Remove="Widgets\Figlet\Fonts\Standard.flf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wcwidth.Sources" PrivateAssets="all" />
    <PackageReference Include="System.Memory" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="Polyfill" Condition="'$(TargetFramework)' == 'netstandard2.0'" PrivateAssets="all" />
  </ItemGroup>

</Project>
